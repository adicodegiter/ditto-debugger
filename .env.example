# Local endpoints only. Do not put passwords or tokens in this file.
# Loopback only. 127.0.0.1, not "localhost": on Windows localhost tries IPv6 ::1 first (+2 s per connection).
DITTO_BASE_URL=http://127.0.0.1:8080
PROMETHEUS_URL=http://127.0.0.1:9090

# AI provider for Agent 3: none (deterministic, the default) or groq.
# To enable Groq: copy this file to .env (git-ignored), set AI_PROVIDER=groq and paste your key after GROQ_API_KEY=.
# Never commit .env or put the key in this file.
AI_PROVIDER=none
GROQ_API_KEY=
# A model id from Groq's current model list. If empty, ai/llm.py uses openai/gpt-oss-120b (listed for the team's key; check yours with python -m ai.llm).
GROQ_MODEL=
# Hard cap on Groq calls per process; past it the deterministic findings are used.
GROQ_MAX_CALLS=30
