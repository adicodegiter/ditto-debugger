{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ditto-ai-chaos/schemas/observation.schema.json",
  "title": "Normalized telemetry observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metric", "value", "observed_at", "source", "labels", "quality"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "metric": { "type": "string", "minLength": 1 },
    "value": { "type": "number" },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "quality": { "enum": ["fresh", "stale"] }
  }
}
