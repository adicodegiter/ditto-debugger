{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ditto-ai-chaos/schemas/experiment-plan.schema.json",
  "title": "Ranked experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "ranking_method", "candidates", "policy_rejections", "execution_enabled", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "ranking_method": { "type": "string", "minLength": 1 },
    "candidates": { "type": "array", "items": { "$ref": "./experiment.schema.json" } },
    "policy_rejections": { "type": "array", "items": { "type": "object" } },
    "execution_enabled": { "const": false },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
