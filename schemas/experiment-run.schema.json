{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ditto-ai-chaos/schemas/experiment-run.schema.json",
  "title": "Experiment execution record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "status", "created_at", "prediction", "observations", "cleanup_state"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["approved", "running", "recovering", "completed", "aborted", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "prediction": { "type": "object" },
    "observations": { "type": "array", "items": { "type": "object" } },
    "cleanup_state": { "enum": ["not_started", "required", "complete", "failed"] },
    "safety_violation": { "type": "boolean", "default": false },
    "abort_reason": { "type": "string" },
    "error": { "type": "string" },
    "recovery": { "type": "object" },
    "recovery_verified": { "type": "boolean" },
    "recovery_time_seconds": { "type": "number", "minimum": 0 },
    "baseline_valid": { "type": "boolean" },
    "score_components": { "type": "object" },
    "resilience_score": { "type": "object" },
    "timeline": { "type": "object", "additionalProperties": { "type": "string", "format": "date-time" } },
    "watchdog": { "type": "object", "properties": { "armed": { "type": "boolean" }, "deadline": { "type": "string", "format": "date-time" } } },
    "error_detail": { "type": "string" },
    "baseline_write_p95_ms": { "type": ["number", "null"] },
    "forced_test": { "type": "boolean" },
    "forced_test_rule": { "type": "string" },
    "forced_test_passed": { "type": "boolean" },
    "dry_run": { "type": "boolean" },
    "dry_run_commands": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "object" } }
  }
}